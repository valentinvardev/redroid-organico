generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here. The migration/introspection URL lives
// in prisma.config.ts; the runtime client gets its connection from the pg
// driver adapter in lib/db.ts.
datasource db {
  provider = "postgresql"
}

enum Platform {
  /// The app under test: a highlights/clips platform for sports photographers.
  SPORT_REELS
  TIKTOK
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  NEEDS_REAUTH
}

enum ProxyType {
  HTTP
  SOCKS5
}

/// Whether the device-side session for this account actually works. Kept apart
/// from `status`, which is operator intent: an account can be ACTIVE (the
/// operator wants it used) while its session is NONE (nobody has logged in on
/// the device yet). Collapsing the two would make "enabled" and "usable"
/// indistinguishable.
enum SessionState {
  NONE
  ONBOARDING
  VERIFIED
  EXPIRED
}

enum JobType {
  PUBLISH_VIDEO
  INTERACTIVE_ONBOARDING
}

enum VideoStatus {
  UPLOADING
  VALIDATING
  READY
  INVALID
}

enum JobStatus {
  QUEUED
  SCHEDULED
  PROCESSING
  /// The worker is holding a live device and waiting for a person to finish
  /// something on it. Distinct from PROCESSING because the dashboard has to
  /// know when to offer the screen, and because nothing is wrong with a job
  /// that sits here for ten minutes.
  AWAITING_HUMAN
  /// The person said they were done and the worker is checking whether the app
  /// agrees. Explicit rather than inferred from `humanConfirmedAt`: a job that
  /// dies here has to be distinguishable from one that died waiting.
  VERIFYING
  COMPLETED
  FAILED
  CANCELLED
  DEAD
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  /// scrypt: N$r$p$salt$derivedKey, all base64. See lib/auth/password.ts.
  /// Null means the account cannot log in with a password.
  passwordHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  videos   Video[]
  jobs     Job[]
  sessions Session[]
  proxies  Proxy[]

  @@map("users")
}

/// An egress the worker forces an account's traffic through.
///
/// Nothing here is configured inside Android. The worker starts a tun2socks
/// container per job and puts the ReDroid container in *its* network namespace,
/// so the device has no interface that bypasses this — an app cannot opt out of
/// a proxy it cannot see. See lib/android/proxyGateway.ts.
model Proxy {
  id     String @id @default(cuid())
  userId String

  /// What the operator picks it by in the dashboard.
  label String

  type ProxyType @default(SOCKS5)
  host String
  port Int

  username String?

  /// AES-256-GCM envelope, same format and key as Account.credentials: a proxy
  /// password is a credential like any other, and residential providers bill
  /// per gigabyte, so a leaked one costs money as well as anonymity. Never
  /// logged, never returned by the API. See lib/crypto/secretBox.ts.
  password Bytes?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@unique([userId, label])
  @@index([userId])
  @@map("proxies")
}

model Session {
  /// SHA-256 of the cookie value. The raw token is never stored, so a dump of
  /// this table cannot be replayed as a login.
  tokenHash String   @id
  userId    String
  expiresAt DateTime

  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id       String        @id @default(cuid())
  userId   String
  name     String
  platform Platform      @default(SPORT_REELS)
  status   AccountStatus @default(ACTIVE)

  /// Platform-side identifier returned by the provider after OAuth.
  externalId String?

  /// AES-256-GCM envelope: iv(12) || tag(16) || ciphertext.
  /// Never logged, never returned by the API. See lib/crypto/secretBox.ts.
  credentials Bytes?

  tokenExpiresAt DateTime?

  /// Set by an INTERACTIVE_ONBOARDING job once a person has logged in on the
  /// device and the verification flow confirmed it.
  sessionState      SessionState @default(NONE)
  sessionVerifiedAt DateTime?

  /// Per-account throttling, enforced by the worker's rate limiter (M4).
  maxConcurrent      Int @default(1)
  minIntervalSeconds Int @default(60)

  /// Egress for every container this account runs in. Null means the traffic
  /// leaves through the host's own address, which for a real account is a
  /// datacentre IP and the fastest way to get it flagged.
  proxyId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SetNull rather than Restrict: a database-level Restrict would also fire
  /// while cascading a user deletion, where the order accounts and proxies are
  /// removed in is Postgres's business, not ours. Refusing to delete a proxy an
  /// account still uses belongs in the service — see lib/proxy/service.ts, which
  /// is the only thing that deletes one.
  proxy Proxy? @relation(fields: [proxyId], references: [id], onDelete: SetNull)
  jobs  Job[]

  @@unique([userId, platform, externalId])
  @@index([userId])
  @@index([status])
  @@index([proxyId])
  @@map("accounts")
}

model Video {
  id     String @id @default(cuid())
  userId String

  fileName      String
  storageKey    String
  storageDriver String @default("local")
  mimeType      String
  sizeBytes     BigInt

  durationSeconds Float?
  width           Int?
  height          Int?

  /// SHA-256 of the uploaded bytes, used to deduplicate re-uploads.
  checksumSha256 String?
  thumbnailKey   String?

  status           VideoStatus @default(UPLOADING)
  validationErrors Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@unique([userId, checksumSha256])
  @@index([userId, createdAt])
  @@map("videos")
}

model Job {
  id        String @id @default(cuid())
  userId    String
  accountId String

  type JobType @default(PUBLISH_VIDEO)

  /// Null for INTERACTIVE_ONBOARDING, which carries no media and no text.
  /// The publish path re-checks both rather than trusting the type alone.
  videoId String?
  caption String? @db.Text

  status JobStatus @default(QUEUED)

  /// How to reach this job's device while it is AWAITING_HUMAN: serial, adb
  /// server, and a ready-made viewer URL for the dashboard to embed. Written by
  /// the worker, read by the UI — it is the only way the browser learns which
  /// of N ephemeral containers to show.
  deviceEndpoint Json?

  awaitingSince DateTime?
  /// When an unattended interactive job gives up. A partner who closes the tab
  /// must not leave an Android container running until someone notices.
  expiresAt DateTime?
  /// Stamped by the API when the person says they are done. The worker treats
  /// this as the durable form of the wake-up signal.
  humanConfirmedAt DateTime?

  /// Set by the API before enqueueing. The unique constraint is what makes a
  /// retry — from BullMQ or from a double-clicked button — impossible to turn
  /// into a duplicate publication.
  idempotencyKey String @unique

  queueName String @default("publish")
  bullJobId String?

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  /// Null means "publish as soon as a worker is free".
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  /// Identifier of the resulting post on the platform, when publishing succeeds.
  externalPostId String?
  errorMessage   String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  video   Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  logs    JobLog[]

  @@index([status])
  @@index([accountId, status])
  @@index([userId, createdAt])
  @@index([scheduledAt])
  /// Drives the sweep that expires abandoned interactive jobs.
  @@index([status, expiresAt])
  @@map("jobs")
}

model JobLog {
  id      String   @id @default(cuid())
  jobId   String
  level   LogLevel @default(INFO)
  message String   @db.Text
  data    Json?

  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("job_logs")
}
