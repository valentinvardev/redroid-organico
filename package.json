{
  "name": "redroid-organico",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "//postinstall": "A fresh clone otherwise fails with \"Cannot find module '.prisma/client/default'\" the first time anything imports lib/db.ts, which npm ci gives no hint about.",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "test": "npm run smoke && npm run test:integration",
    "test:integration": "tsx --env-file=.env.test --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:setup": "tsx scripts/setupTestDb.ts",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "user:create": "tsx scripts/createUser.ts",
    "token:create": "tsx scripts/apiToken.ts create",
    "token:list": "tsx scripts/apiToken.ts list",
    "token:revoke": "tsx scripts/apiToken.ts revoke",
    "account:add": "tsx scripts/addAccount.ts",
    "gateway:test": "tsx scripts/testGateway.ts",
    "device:egress": "tsx scripts/testDeviceEgress.ts",
    "keys:rotate": "tsx scripts/rotateCredentials.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bullmq": "^5.81.2",
    "dotenv": "^17.4.2",
    "geist": "^1.7.2",
    "https-proxy-agent": "^7.0.6",
    "ioredis": "^5.11.1",
    "next": "14.2.15",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socks-proxy-agent": "^8.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/pg": "^8.20.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "tsx": "^4.23.1",
    "typescript": "5.6.3"
  }
}
