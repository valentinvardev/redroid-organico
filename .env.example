# Copy to .env and fill in. Never commit .env.

# --- Datastores ---------------------------------------------------------------
# Port 5433: docker-compose.dev.yml publishes Postgres there so it does not
# collide with a natively installed PostgreSQL on 5432.
DATABASE_URL="postgresql://redroid:redroid@localhost:5433/redroid?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Secrets -----------------------------------------------------------------
# 32 random bytes, base64. Encrypts Account.credentials at rest.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=""

# Retired keys, comma-separated. Decrypt-only. Set during a rotation so
# credentials sealed with the previous key stay readable, run
# `npm run keys:rotate`, then clear this. See the Rotation section of README.md.
CREDENTIALS_KEYS_OLD=""

# --- Media storage -----------------------------------------------------------
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.storage"

# Required when STORAGE_DRIVER=s3. S3_ENDPOINT is for R2/MinIO/etc.
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Media tooling -----------------------------------------------------------
# Uploads are accepted but skip validation when these are missing.
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# --- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY="4"

# Which publisher adapter the worker uses. "stub" runs the full pipeline
# without contacting any platform; "noop" accepts the publish request without
# validating or uploading media. "tiktok" uses TikTok API credentials from
# Account.credentials. "android" drives the app under test over ADB/Appium on a
# real device, an emulator, or a ReDroid container created per job.
PUBLISHER_DRIVER="stub"

# How often the worker sweeps for Android containers whose job is no longer
# running. Only used with PUBLISHER_DRIVER=android. The startup sweep always
# runs and is the only thing that cleans up after a SIGKILLed worker; 0 disables
# just the periodic one. Raise it if you run many worker replicas.
ANDROID_REAPER_INTERVAL_MS="300000"

# --- Interactive onboarding ---------------------------------------------------
# How long a linking session holds a live device waiting for a person. A closed
# browser tab sends nothing, so this deadline is what stops an abandoned session
# from keeping an Android container alive.
ONBOARDING_TIMEOUT_MS="1200000"

# Where the dashboard points the screen-sharing iframe. {serial} is replaced
# with the device serial. Empty disables the embed: the job still runs and
# reports the serial, there is just nothing to look at.
#
# This URL is opened by the OPERATOR'S BROWSER, not by a container — so the host
# is whatever the ws-scrcpy service is published on. For `docker compose
# --profile android up` on your own machine that is localhost:8000; on a server
# it is that server's hostname behind TLS.
DEVICE_VIEWER_URL_TEMPLATE="http://localhost:8000/#!action=stream&udid={serial}&decoder=mse"

# Retry budget and exponential backoff base. Defaults give 15s/60s/240s.
RETRY_ATTEMPTS="3"
RETRY_BACKOFF_MS="15000"

# How long a job waits after an account's concurrency limit turns it away.
# Unlike a retry, this does not consume an attempt.
RATE_LIMIT_DEFER_MS="30000"

# --- Accounts ----------------------------------------------------------------
# Opens POST /api/auth/register to anyone who can reach it. Leave it off and add
# operators with:  npm run user:create -- someone@example.com
ALLOW_REGISTRATION="false"
