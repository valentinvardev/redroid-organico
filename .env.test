# Loaded via --env-file by `npm run test:integration`, so these are in place
# before any module reads process.env.
#
# Separate database AND separate Redis logical DB (index 1): the suite truncates
# tables and flushes keys, which would otherwise wipe the dev queue.
DATABASE_URL="postgresql://redroid:redroid@localhost:5433/redroid_test?schema=public"
REDIS_URL="redis://localhost:6379/1"

# Fixed key: encrypts nothing real and keeps runs reproducible.
# Must decode to exactly 32 bytes — the previous value here decoded to 35 and
# made every seal() call throw.
CREDENTIALS_KEY="cmVkcm9pZC1vcmdhbmljby10ZXN0LWtleS0zMmJ5dGU="

STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.storage-test"

PUBLISHER_DRIVER="stub"
WORKER_CONCURRENCY="4"
NODE_ENV="test"

# Real backoff is 15s/60s/240s. Compressed here so exercising the full retry
# budget takes well under a second instead of five minutes.
RETRY_ATTEMPTS="3"
RETRY_BACKOFF_MS="60"

# Real value is 30s. Compressed so the concurrency-deferral test does not have
# to sit through it.
RATE_LIMIT_DEFER_MS="150"

# Real value is 20 minutes. At the schema minimum here so an onboarding test
# that never confirms cannot hold the suite open.
ONBOARDING_TIMEOUT_MS="60000"
