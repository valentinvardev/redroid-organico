# ws-scrcpy built from source: the screen the operator sees during onboarding.
#
# NetrisTV publishes no official image, and the community tags we tried did not
# exist. Building from the repository removes the dependency on someone else's
# tag staying published — the same reason Appium is built here rather than
# pulled.
#
# It reaches devices through the SHARED adb server, never its own. A viewer with
# its own server would see an empty device list: the device is attached over TCP
# by the worker, and only the server that ran `adb connect` knows about it.
FROM node:20-bookworm-slim AS build

RUN apt-get update \
 && apt-get install -y --no-install-recommends git python3 make g++ ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Not pinned to a tag because the project does not publish usable ones. Pin the
# commit below once a working revision is confirmed, the way appium is pinned.
ARG WS_SCRCPY_REF=master
RUN git clone --depth 1 --branch "${WS_SCRCPY_REF}" https://github.com/NetrisTV/ws-scrcpy.git .

RUN npm install --no-audit --no-fund
RUN npm run dist

# Production dependencies are installed *here*, where the toolchain lives.
# node-pty is a native module: installing it in the runtime stage means putting
# python3, make and g++ in the final image just to compile something the build
# stage could have compiled and handed over.
RUN cd dist && npm install --no-audit --no-fund --omit=dev


FROM node:20-bookworm-slim AS runtime

RUN apt-get update \
 && apt-get install -y --no-install-recommends adb ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# ws-scrcpy uses two different paths to reach a device: adbkit for the device
# list, and the adb *binary* to launch scrcpy-server on the phone. The env vars
# steer the library; the binary ignores them and starts a private server that
# knows about no devices — which shows up as a device that lists fine and then
# fails with "device not found" the moment you try to stream it.
#
# Rather than guess which of the several ANDROID_ADB_SERVER_* spellings this
# adb build honours, /usr/local/bin comes first in PATH and every invocation is
# routed to the shared server explicitly.
RUN printf '#!/bin/sh\nexec /usr/bin/adb -H "${ADB_HOST:-127.0.0.1}" -P "${ADB_PORT:-5037}" "$@"\n' \
      > /usr/local/bin/adb \
 && chmod +x /usr/local/bin/adb

WORKDIR /app
COPY --from=build /src/dist ./

EXPOSE 8000
CMD ["node", "index.js"]
